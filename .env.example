# Pulse MCP: the only data source Cooper uses.
PULSE_MCP_URL=https://ado-mcp.fieldassist.io/mcp/data
# Your personal Pulse MCP access token (ask the Pulse MCP admin). Never commit the real .env file.
PULSE_MCP_TOKEN=
# Optional extra headers if your gateway needs them, as "Name: value; Name2: value2"
PULSE_MCP_HEADERS=

# Local model via Ollama. Set COOPER_LLM=off to run with rule-based wording only.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
COOPER_LLM=on

# Optional: a fixed secret keeps your company lock valid across server restarts.
COOPER_SECRET=

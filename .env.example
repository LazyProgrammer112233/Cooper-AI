# Pulse MCP: the only data source Cooper uses.
PULSE_MCP_URL=https://ado-mcp.fieldassist.io/mcp
# Leave empty. You sign in with your FieldAssist ID from the "Connect and authorize Pulse MCP"
# button in Cooper; the sign-in is saved on this laptop (backend/data/auth/) and refreshed for you.
PULSE_MCP_TOKEN=
# Optional extra headers if your gateway needs them, as "Name: value; Name2: value2"
PULSE_MCP_HEADERS=

# Local model via Ollama. Set COOPER_LLM=off to run with rule-based wording only.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
COOPER_LLM=on

# Optional: a fixed secret keeps your company lock valid across server restarts.
COOPER_SECRET=

# The address you open Cooper on. The FieldAssist sign-in returns here, so keep it matching.
COOPER_PUBLIC_URL=http://localhost:8000

# Voice input: local Whisper speech-to-text (free, offline after the first download).
# Models: large-v3-turbo (best, needs a GPU for fast answers), medium, small (fast on CPU).
COOPER_STT=on
COOPER_STT_MODEL=large-v3-turbo
COOPER_STT_DEVICE=auto

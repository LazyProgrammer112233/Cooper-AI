  "seasons": [
    {
      "id": "month_end",
      "rule": "last_days_of_month",
      "days": 5,
      "note": "Month-end: distributors load primary stock in the last few days of the month to meet targets, so primary sales usually peak then and dip in the first week of the next month.",
      "effect": 1
    },
    {
      "id": "month_start",
      "rule": "first_days_of_month",
      "days": 7,
      "note": "Start of month: primary billing is usually slow in the first week after the month-end push.",
      "effect": -1
    },
    {
      "id": "pre_diwali",
      "rule": "before_holiday",
      "holiday": "Diwali",
      "days": 21,
      "note": "Festive stock-up: retailers and distributors buy ahead of Diwali, which lifts orders and billing in the three weeks before it.",
      "effect": 1
    },
    {
      "id": "post_diwali",
      "rule": "after_holiday",
      "holiday": "Diwali",
      "days": 10,
      "note": "Post-Diwali dip: shops are stocked up and many field staff and retailers take leave, so calls and orders usually fall for a week or two after Diwali.",
      "effect": -1
    },
    {
      "id": "navratri",
      "rule": "during_holiday",
      "holiday": "Navratri",
      "note": "Navratri: fasting changes buying patterns (snacks, staples and oils shift), and markets in Gujarat, Maharashtra and the north are busier in the evenings.",
      "effect": 0
    },
    {
      "id": "monsoon",
      "rule": "months",
      "months": [
        7,
        8,
        9
      ],
      "note": "Monsoon: heavy rain cuts outlet visits, especially in rural and flood-prone beats, and shifts demand across categories.",
      "effect": -1
    },
    {
      "id": "summer",
      "rule": "months",
      "months": [
        4,
        5,
        6
      ],
      "note": "Summer: beverages, ice cream and personal care peak, while afternoon heat cuts the number of calls a rep can make.",
      "effect": 0
    },
    {
      "id": "fy_end",
      "rule": "months",
      "months": [
        3
      ],
      "note": "Financial-year close (March): companies push primary billing to close the year, and some distributors hold back to manage credit.",
      "effect": 1
    }
  ]
}

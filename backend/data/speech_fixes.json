{
  "_about": "Common speech-to-text mishearings for Indian English and Hindi, fixed before Cooper reads the question (and in the message box before a voice question is sent). Each entry is [pattern, replacement]; patterns are case-insensitive regular expressions that work in both Python and JavaScript.",
  "fixes": [
    ["\\bproductive (cause|causes|cost|costs|course|courses|coal|coals|kaul|kaal|call's|cars)\\b", "productive calls"],
    ["\\btotal (cause|causes|cost|costs|course|courses|coal|coals|kaul|call's)\\b", "total calls"],
    ["\\b(pee see|pee c|p\\.c\\.|p c)\\b", "PC"],
    ["\\b(tee see|tea see|t\\.c\\.|t c)\\b", "TC"],
    ["\\b(you be oh|you be o|you bee oh|u b o|u\\.b\\.o\\.?|you bio|you b o)\\b", "UBO"],
    ["\\b(l m t d|l\\.m\\.t\\.d\\.?|el mtd|el m t d)\\b", "LMTD"],
    ["\\b(m t d|m\\.t\\.d\\.?|empty d|empty dee|em tee dee)\\b", "MTD"],
    ["\\b(y t d|y\\.t\\.d\\.?|why td|why t d)\\b", "YTD"],
    ["\\b(q t d|q\\.t\\.d\\.?|queue td)\\b", "QTD"],
    ["\\b(s k u|s\\.k\\.u\\.?|skew|s k you|ask you)s\\b", "SKUs"],
    ["\\b(s k u|s\\.k\\.u\\.?|skew|s k you)\\b", "SKU"],
    ["\\b(l p c|l\\.p\\.c\\.?)\\b", "LPC"],
    ["\\b(p j p|p\\.j\\.p\\.?)\\b", "PJP"],
    ["\\b(u t c|you tc|you t c)\\b", "UTC"],
    ["\\b(u p c|you pc|you p c)\\b", "UPC"],
    ["\\bprimary (sails|sail|cells|cell|sells|seals)\\b", "primary sales"],
    ["\\bsecondary (sails|sail|cells|cell|sells|seals)\\b", "secondary sales"],
    ["\\b(primary|secondary) sale\\b", "$1 sales"],
    ["\\bdistributer(s?)\\b", "distributor$1"],
    ["\\b(brands?|distributors?|reps?|zones?|regions?|skus?|categories|category|states?|outlets?) buy\\b", "$1 by"],
    ["\\bbuy (primary|secondary|sales|pc|tc|ubo|coverage|penetration|order|value|drop size)\\b", "by $1"],
    ["\\bsales (rips|ribs|reaps|rapes|raps|wraps)\\b", "sales reps"],
    ["\\b(rips|reaps)\\b(?= (kya|ka|ki|ke|doing|are|ko))", "reps"],
    ["\\b(cupper|coper|kupar|kooper|cooperr)\\b", "Cooper"],
    ["\\bdistribute ers?\\b", "distributors"],
    ["\\boutlate(s?)\\b", "outlet$1"],
    ["\\bout let(s?)\\b", "outlet$1"],
    ["\\b(zone|region|state|brand|category|city|territory|distributor|sku|rep) (vise|vice|wice|y's)\\b", "$1 wise"],
    ["\\bcover age\\b", "coverage"],
    ["\\bpenetrate shun\\b", "penetration"],
    ["\\bdrop (sides|side|sighs)\\b", "drop size"],
    ["\\bstrike (right|rights|write)\\b", "strike rate"],
    ["\\blines per (caul|cause|cost|coal)\\b", "lines per call"],
    ["(\\d) (lack|lac|lacs|lakhs|lach)\\b", "$1 lakh"],
    ["(\\d) (core|cores|crores|carore|karod)\\b", "$1 crore"],
    ["\\b(deo leo|dio leo|the oleo|dee oleo|dyo leo|deo lio)\\b", "Deoleo"],
    ["\\b(sales men|sells man|sails man)\\b", "salesmen"],
    ["\\b(this weak|dis week)\\b", "this week"],
    ["\\b(last weak)\\b", "last week"],
    ["पी सी", "पीसी"],
    ["टी सी", "टीसी"],
    ["यू बी ओ", "यूबीओ"],
    ["एम टी डी", "एमटीडी"],
    ["एस के यू", "एसकेयू"],
    ["प्रोडक्टिव कॉज", "प्रोडक्टिव कॉल"]
  ]
